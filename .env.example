# On the server, the deploy workflow writes .env from Vault
# (secret/apps/hashcode-visio); this file documents the keys, and serves
# scripts/setup.sh for a deploy by hand.

# ── Where ─────────────────────────────────────────────────────────────────────
# The call's address. Its DNS A record points at the VPS and stays DNS ONLY
# (grey cloud in Cloudflare): video and TURN cannot pass through the proxy.
VISIO_DOMAIN=visio.hashcode.digital
# The VPS's public IPv4: what browsers send media to (UDP 10000) and what
# coturn announces as its relay address.
VISIO_PUBLIC_IP=203.0.113.10

# ── Rabotka's tokens ──────────────────────────────────────────────────────────
# Rabotka's API signs every call token (HS256) with this secret. It MUST equal
# the JITSI_APP_SECRET the backend reads from Vault (develop and production),
# or every call is refused. Generate: openssl rand -hex 32
JWT_APP_ID=rabotka
JWT_APP_SECRET=changeme

# ── Internal accounts (this server only) ─────────────────────────────────────
# Generate each: openssl rand -hex 24
JICOFO_AUTH_PASSWORD=changeme
JVB_AUTH_PASSWORD=changeme

# ── TURN (coturn) ─────────────────────────────────────────────────────────────
# Shared by coturn (--static-auth-secret) and Prosody (TURN_CREDENTIALS), which
# hands browsers short-lived TURN credentials. Generate: openssl rand -hex 32
TURN_SECRET=changeme
